VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_TOKEN=your_token_here
# Comma-separated list of allowed web origins. REQUIRED in production
# (e.g. https://atlas.vercel.app) - the agent refuses to start without it.
WEB_ORIGIN=http://localhost:3000
# Daily caps on live voice sessions (each one bills OpenAI Realtime)
REALTIME_IP_DAILY_CAP=5
REALTIME_DAILY_SESSION_CAP=150
SQLITE_PATH=atlas.db
PORT=3001
OPENAI_API_KEY=your_openai_api_key_here
