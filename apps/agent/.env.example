VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_TOKEN=your_token_here
WEB_ORIGIN=http://localhost:3000
SQLITE_PATH=atlas.db
PORT=3001
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Auth — required for /calls/* JWT verification.
# JWKS-based verification (default) only needs SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: only needed if you switch from JWKS verification to HS256-shared-secret.
SUPABASE_JWT_SECRET=
