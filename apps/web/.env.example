# --- Required for a live call ---------------------------------------------
# OpenAI Realtime: the prospect's voice + mic transcription
OPENAI_API_KEY=your_openai_api_key_here
# Vercel AI Gateway: suggester, memory extractor, panel agent, chat coach
VERCEL_AI_GATEWAY_TOKEN=your_token_here

# --- Optional --------------------------------------------------------------
# Analytics. The app works without these.
NEXT_PUBLIC_POSTHOG_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Daily spend caps need Redis to persist across cold starts. On Vercel, add the
# Upstash integration from the Marketplace and these are set for you.
# Without them, caps are per-instance (fine for local dev).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Model overrides (defaults are in src/server/llm/wrapper.ts)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# EXTRACTOR_MODEL=openai/gpt-6-luna
# SUGGESTER_MODEL=openai/gpt-6-luna
# SUGGESTER_FALLBACK_MODEL=openai/gpt-6-luna
# COACH_MODEL=openai/gpt-oss-120b
